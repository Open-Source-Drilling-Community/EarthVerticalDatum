<Project Sdk="Microsoft.NET.Sdk.Razor">
  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <AddRazorSupportForMvc>true</AddRazorSupportForMvc>
    <AssemblyName>OSDC.Drilling.EarthVerticalDatum.WebPages</AssemblyName>
    <RootNamespace>OSDC.Drilling.EarthVerticalDatum.WebPages</RootNamespace>
    <PackageId>OSDC.Drilling.EarthVerticalDatum.WebPages</PackageId>
    <Title>OSDC.Drilling.EarthVerticalDatum.WebPages</Title>
    <Authors>Eric Cayeux</Authors>
    <Company>NORCE Research</Company>
    <Description>Reusable Blazor pages for stateless bidirectional EGM84 mean-sea-level and WGS84 ellipsoidal-depth conversion with OSDC unit-system support.</Description>
    <PackageTags>earthverticaldatum;drilling;blazor;razor;mudblazor;osdc</PackageTags>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
    <RepositoryUrl>https://github.com/Open-Source-Drilling-Community/EarthVerticalDatum</RepositoryUrl>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <GeneratePackageOnBuild>true</GeneratePackageOnBuild>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="MudBlazor" Version="8.14.0" />
    <PackageReference Include="OSDC.DotnetLibraries.Drilling.WebAppUtils" Version="1.1.2" />
    <PackageReference Include="OSDC.UnitConversion.DrillingRazorMudComponents" Version="3.3.47" />
  </ItemGroup>
  <ItemGroup>
    <Compile Include="..\ModelSharedOut\EarthVerticalDatumMergedModel.cs" Link="GeneratedDtos\EarthVerticalDatumMergedModel.cs" />
    <Compile Include="..\ModelSharedOut\PseudoConstructors.cs" Link="GeneratedDtos\PseudoConstructors.cs" />
    <None Include="README.md" Pack="true" PackagePath="\" />
  </ItemGroup>
</Project>
